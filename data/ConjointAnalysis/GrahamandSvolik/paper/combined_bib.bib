@InCollection{Fiorina2006,
  Title                    = {{Disconnected: The Political Class versus the People}},
  Author                   = {Fiorina, Morris P. and Levendusky, Matthew S.},
  Booktitle                = {Red and Blue Nation? Characteristics, Causes, and Consequences of America's Polarized Politics},
  Publisher                = {Brookings Institution Press and the Hoover Institute},
  Year                     = {2006},

  Address                  = {Washington, DC},
  Chapter                  = {Disconnect},
  Pages                    = {49--71},

  Abstract                 = {Survey data reveal some evidence of party sorting over the past generation. The party attachments of ordinary Americans have become more closely associated with their ideological self-classifications and with their positions on some issues. But the same data also show that the increase in sorting over the three decades have been modest, contrary to what is often asserted. Our findings conradict any simple assumption that the polarization of America's political class is a direct reflection of a similarly polarized mass electorate.},
