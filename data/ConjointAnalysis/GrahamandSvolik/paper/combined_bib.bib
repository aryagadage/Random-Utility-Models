@Article{Chiozza2004,
  Title                    = {International Conflict and the Tenure of Leaders: Is War Still "Ex Post" Inefficient?},
  Author                   = {{Chiozza, Giacomo} and {Goemans, H. E.}},
  Journal                  = {American Journal of Political Science},
  Number                   = {3},
  Pages                    = {604--619},
  Volume                   = {48},
  Year                     = {2004},

  Month                    = {jul},

  Abstract                 = {Recent work in comparative politics and international relations has shown a marked shift toward leaders as the theoretical unit of analysis. In most of the new theoretical models a core assumption is that leaders act to stay in power. There exists, however, remarkably little systematic empirical knowledge about the factors that affect the tenure of leaders. To provide a baseline of empirical results we explore how a broad range of domestic and international factors affects the tenure of leaders. We focus in particular on the effect of conflict and its outcome. We find that political institutions fundamentally mediate the costs and benefits of international conflict and that war is not necessarily ex post inefficient for leaders. This suggests that the assumption that war is ex post inefficient for unitary rational actors can not be simply extended to leaders. Therefore, a focus on leaders may yield important new rationalist explanations for war.},
  Copyright                = {Copyright 2004 Midwest Political Science Association},
  ISSN                     = {0092-5853},
  Jstor_articletype        = {Full Length Article},
  Jstor_date               = {200407},
  Jstor_formatteddate      = {Jul., 2004},
  Publisher                = {Midwest Political Science Association},
  Url                      = {http://links.jstor.org/sici?sici=0092-5853%28200407%2948%3A3%3C604%3AICATTO%3E2.0.CO%3B2-N}
}

