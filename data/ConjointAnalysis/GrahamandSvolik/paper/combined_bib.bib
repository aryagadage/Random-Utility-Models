@Article{Ranney1968,
  Title                    = {{The Representativeness of Primary Electorates}},
  Author                   = {Ranney, Austin},
  Journal                  = {Midwest Journal of Political Science},
  Number                   = {2},
  Pages                    = {224--238},
  Volume                   = {12},
  Year                     = {1968},

  Abstract                 = {This paper seeks to test V. 0. Key's thesis that in political attitudes primary voters tend to be unrepresentative of their non-voting fellow partisans. A sample of Republican and Democratic voters and non-voters in the 1966 Wisconsin gubernatorial primary were asked twenty-one questions tapping policy preferences and six questions eliciting level of involvement. Statistically significant differences between each partisan pair appeared on only two preference questions but on four of the involvement questions. On none of the questions did a majority of either party's voters express a preference contrary to that of their non-voting fellow partisans. The paper concludes that, at least in Wisconsin, primary voters are not significantly unrepresentative of the general party following in issue positions or candidate preferences, but only as the active and involved are socially and economically unrepresentative of the inactive and uninvolved in all elections. IN},
  Doi                      = {10.2307/2110334},
